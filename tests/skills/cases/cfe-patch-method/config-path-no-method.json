{
  "name": "Гвард: метод не найден в основной конфигурации",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "CommonModule",
        "name": "ПустойМод",
        "properties": {
          "Server": true
        }
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "writeFile": {
        "path": "CommonModules/ПустойМод/Ext/Module.bsl",
        "content": "#Область ПрограммныйИнтерфейс\n\nПроцедура Другой() Экспорт\n\tШаг();\nКонецПроцедуры\n\n#КонецОбласти\n"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/ext",
        "-ConfigPath": "{workDir}"
      }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": {
        "-ExtensionPath": "{workDir}/ext",
        "-ConfigPath": "{workDir}",
        "-Object": "CommonModule.ПустойМод"
      }
    }
  ],
  "params": {
    "extensionPath": "ext",
    "modulePath": "CommonModule.ПустойМод",
    "methodName": "НетТакого",
    "interceptorType": "Before"
  },
  "expectError": "не найден"
}
