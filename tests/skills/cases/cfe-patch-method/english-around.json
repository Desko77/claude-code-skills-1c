{
  "name": "Перехватчик Вместо по английской функции",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "АнглМодуль", "properties": { "Server": true } },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "writeFile": {
        "path": "CommonModules/АнглМодуль/Ext/Module.bsl",
        "content": "#If Сервер Or ТолстыйКлиентОбычноеПриложение Then\n\n#Region ПрограммныйИнтерфейс\n\nFunction ПолучитьЗначение(Val Ключ, ПоУмолчанию = Неопределено) Export\n\tReturn Ключ;\nEndFunction\n\n#EndRegion\n\n#EndIf\n"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": { "-ExtensionPath": "{workDir}/ext", "-ConfigPath": "{workDir}", "-Object": "CommonModule.АнглМодуль" }
    }
  ],
  "params": {
    "extensionPath": "ext",
    "modulePath": "CommonModule.АнглМодуль",
    "methodName": "ПолучитьЗначение",
    "interceptorType": "Instead"
  },
  "noSnapshot": "проверяется разбор английского модуля и русский текст перехватчика, а не каталог cfe-init",
  "expect": {
    "stdoutContains": [
      "&Вместо(\"ПолучитьЗначение\")",
      "Препроцессор: #Если:Сервер Or ТолстыйКлиентОбычноеПриложение"
    ],
    "fileContains": {
      "file": "ext/CommonModules/АнглМодуль/Ext/Module.bsl",
      "text": [
        "#Если Сервер Or ТолстыйКлиентОбычноеПриложение Тогда",
        "Функция Тест_ПолучитьЗначение(Val Ключ, ПоУмолчанию = Неопределено)",
        "ПродолжитьВызов(Ключ, ПоУмолчанию)",
        "КонецФункции",
        "#КонецЕсли"
      ]
    },
    "fileNotContains": {
      "file": "ext/CommonModules/АнглМодуль/Ext/Module.bsl",
      "text": ["EndFunction", "ПродолжитьВызов(Val", "#If ", "#EndIf"]
    }
  }
}
