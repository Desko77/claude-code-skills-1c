{
  "name": "Ресинк английского модуля: маркеры Insert и Delete",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "CommonModule", "name": "АнглМаркер", "properties": { "Server": true } },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "writeFile": {
        "path": "CommonModules/АнглМаркер/Ext/Module.bsl",
        "content": "#Region ПрограммныйИнтерфейс\n\nProcedure П() Export\n\tШаг1();\n\tШаг2();\n\tШаг3();\n\tШаг4();\nEndProcedure\n\n#EndRegion\n"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": { "-ExtensionPath": "{workDir}/ext", "-ConfigPath": "{workDir}", "-Object": "CommonModule.АнглМаркер" }
    },
    {
      "writeFile": {
        "path": "ext/CommonModules/АнглМаркер/Ext/Module.bsl",
        "content": "#Region ПрограммныйИнтерфейс\n&ChangeAndValidate(\"П\")\nProcedure Тест_П()\n\tШаг1();\n#Insert\n\tШагВставка();\n#EndInsert\n#Delete\n\tШаг2();\n#EndDelete\n\tШаг3();\nEndProcedure\n#EndRegion\n"
      }
    }
  ],
  "params": {
    "extensionPath": "ext",
    "modulePath": "CommonModule.АнглМаркер",
    "methodName": "П",
    "interceptorType": "ModificationAndControl"
  },
  "noSnapshot": "проверяется разбор английских маркеров и русская перезапись перехватчика, а не каталог cfe-init",
  "expect": {
    "stdoutContains": "правок сохранено: 2",
    "fileContains": {
      "file": "ext/CommonModules/АнглМаркер/Ext/Module.bsl",
      "text": [
        "Процедура Тест_П()",
        "КонецПроцедуры",
        "#Вставка",
        "#КонецВставки",
        "#Удаление",
        "#КонецУдаления",
        "ШагВставка()"
      ]
    },
    "fileNotContains": {
      "file": "ext/CommonModules/АнглМаркер/Ext/Module.bsl",
      "text": ["#Insert", "#Delete", "Procedure", "EndProcedure"]
    }
  }
}
