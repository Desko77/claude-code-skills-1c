{
  "script": "xdto-info/scripts/xdto-info",
  "setup": "empty-config",
  "args": [
    { "flag": "-PackagePath", "from": "workPath", "field": "packagePath" },
    { "flag": "-OutFile", "from": "workPath", "field": "outFile" }
  ],
  "snapshot": {
    "root": "workDir",
    "normalizeUuids": true
  }
}
