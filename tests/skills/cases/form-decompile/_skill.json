{
  "script": "form-decompile/scripts/form-decompile",
  "setup": "empty-config",
  "args": [
    { "flag": "-InputFile", "from": "workPath", "field": "formPath" },
    { "flag": "-OutputFile", "from": "workPath", "field": "outputPath" }
  ],
  "snapshot": {
    "root": "workDir",
    "normalizeUuids": true
  }
}
