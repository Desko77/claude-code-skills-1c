{
  "name": "Декомпиляция: автоименованные обработчики событий таблицы и полей не выводятся явными handlers",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "DataProcessor", "name": "ПодборТоваров" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": { "-ObjectPath": "{workDir}/DataProcessors/ПодборТоваров.xml", "-FormName": "Форма" }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "title": "Подбор товаров",
        "elements": [
          { "input": "Комментарий", "path": "Комментарий", "on": ["EditTextChange", "Creating", "Opening"] },
          { "calendar": "Дата", "path": "Дата", "on": ["OnActivate"] },
          { "table": "Товары", "path": "Товары",
            "on": ["OnEditEnd", "BeforeEditEnd", "ValueChoice", "OnActivateCell", "OnActivateField", "DragEnd"],
            "columns": [ { "input": "ТоварыНоменклатура", "path": "Товары.Номенклатура" } ]
          }
        ],
        "attributes": [
          { "name": "Комментарий", "type": "string" },
          { "name": "Дата", "type": "date" },
          { "name": "Товары", "type": "ValueTable", "columns": [ { "name": "Номенклатура", "type": "string" } ] }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/DataProcessors/ПодборТоваров/Forms/Форма/Ext/Form.xml"
      }
    }
  ],
  "params": {
    "formPath": "DataProcessors/ПодборТоваров/Forms/Форма/Ext/Form.xml",
    "outputPath": "draft.json"
  },
  "expect": {
    "files": ["draft.json"],
    "fileContains": [
      { "file": "draft.json", "text": ["\"OnEditEnd\"", "\"BeforeEditEnd\"", "\"ValueChoice\"", "\"EditTextChange\"", "\"OnActivate\""] }
    ],
    "fileNotContains": [
      { "file": "draft.json", "text": ["ТоварыПриОкончанииРедактирования", "КомментарийИзменениеТекстаРедактирования", "ДатаПриАктивизации"] }
    ]
  }
}
