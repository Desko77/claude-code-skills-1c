{
  "name": "ПВХ — составной ТипЗначения сворачивается, drill-down разворачивает",
  "setup": "empty-config",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "ChartOfCharacteristicTypes",
        "name": "ВидыСубконто",
        "valueType": "String(100) + Number(10,2) + Date + Boolean + CatalogRef + DocumentRef"
      },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    }
  ],
  "params": { "objectPath": "ChartsOfCharacteristicTypes/ВидыСубконто" },
  "expect": {
    "stdoutContains": [
      "Стандартные реквизиты:",
      "ТипЗначения",
      "Составной (6)",
      "Полный состав типов: -Name ТипЗначения"
    ],
    "stdoutNotContains": ["cfg:", "СправочникСсылка |"]
  }
}
