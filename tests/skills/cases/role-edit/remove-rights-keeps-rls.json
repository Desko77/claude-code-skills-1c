{
  "name": "remove-rights: право, возвращенное замыканием, сохраняет условие RLS",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "role-compile/scripts/role-compile",
      "input": {
        "name": "Кладовщик",
        "objects": [
          {
            "name": "Catalog.Товары",
            "rights": {
              "Edit": true
            },
            "rls": {
              "Read": "ГДЕ Ложь"
            }
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "rolePath": "Roles/Кладовщик.xml"
  },
  "validatePath": "Roles/Кладовщик/Ext/Rights.xml",
  "input": {
    "operation": "remove-rights",
    "object": "Catalog.Товары",
    "rights": "Read"
  },
  "expect": {
    "stdoutContains": "role-edit:",
    "fileContains": {
      "file": "Roles/Кладовщик/Ext/Rights.xml",
      "text": [
        "<restrictionByCondition>",
        "ГДЕ Ложь"
      ]
    }
  }
}