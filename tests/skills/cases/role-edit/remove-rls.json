{
  "name": "remove-rls: условие снято, право Read остается",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Catalog", "name": "Товары" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "role-compile/scripts/role-compile",
      "input": {
        "name": "Кладовщик",
        "objects": [
          {
            "name": "Catalog.Товары",
            "preset": "view",
            "rls": { "Read": "#ПоОрганизации(\"\")" }
          }
        ],
        "templates": [
          { "name": "ПоОрганизации(Мод)", "condition": "ГДЕ Организация = &ТекущаяОрганизация" }
        ]
      },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    }
  ],
  "params": { "rolePath": "Roles/Кладовщик.xml" },
  "validatePath": "Roles/Кладовщик/Ext/Rights.xml",
  "input": {
    "operation": "remove-rls",
    "object": "Catalog.Товары",
    "right": "Read"
  },
  "expect": {
    "stdoutContains": "role-edit:",
    "fileContains": [
      { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<name>Read</name>" },
      { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<name>ПоОрганизации(Мод)</name>" }
    ],
    "fileNotContains": { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<restrictionByCondition>" }
  }
}
