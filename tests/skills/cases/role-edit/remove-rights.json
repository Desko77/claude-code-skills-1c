{
  "name": "remove-rights: InputByString снят, Read и View остаются",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Catalog", "name": "Товары" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "role-compile/scripts/role-compile",
      "input": {
        "name": "Кладовщик",
        "objects": ["Catalog.Товары: @view"]
      },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    }
  ],
  "params": { "rolePath": "Roles/Кладовщик.xml" },
  "validatePath": "Roles/Кладовщик/Ext/Rights.xml",
  "input": {
    "operation": "remove-rights",
    "object": "Catalog.Товары",
    "rights": "InputByString"
  },
  "expect": {
    "stdoutContains": "role-edit:",
    "fileContains": [
      { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<name>Read</name>" },
      { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<name>View</name>" }
    ],
    "fileNotContains": { "file": "Roles/Кладовщик/Ext/Rights.xml", "text": "<name>InputByString</name>" }
  }
}
