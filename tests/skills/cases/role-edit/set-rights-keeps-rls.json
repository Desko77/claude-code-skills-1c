{
  "name": "set-rights: условие RLS права, оставленного замыканием, сохраняется",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "role-compile/scripts/role-compile",
      "input": {
        "name": "Кладовщик",
        "objects": [
          {
            "name": "Catalog.Товары",
            "rights": {
              "Read": true,
              "View": true,
              "Update": true
            },
            "rls": {
              "Update": "ГДЕ Ложь"
            }
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "rolePath": "Roles/Кладовщик.xml"
  },
  "validatePath": "Roles/Кладовщик/Ext/Rights.xml",
  "input": {
    "operation": "set-rights",
    "object": "Catalog.Товары",
    "rights": "Edit"
  },
  "expect": {
    "stdoutContains": "role-edit:",
    "fileContains": {
      "file": "Roles/Кладовщик/Ext/Rights.xml",
      "text": [
        "<restrictionByCondition>",
        "ГДЕ Ложь"
      ]
    }
  }
}