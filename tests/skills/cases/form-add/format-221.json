      {
        "file": "Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form.xml",
        "text": "xmlns:lf=\"http://v8.1c.ru/8.2/managed-application/logform\" xmlns:pal=\"http://v8.1c.ru/8.1/data/ui/colors/palette\" xmlns:style="
      }
    ]
  }
}
