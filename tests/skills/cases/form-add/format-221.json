{
  "name": "Формат 2.21 (8.5): xmlns:pal в шапках метаданных формы и Form.xml",
  "setup": "empty-config-221",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
