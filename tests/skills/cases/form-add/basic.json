{
  "name": "Добавление формы к справочнику",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "Catalogs/Товары.xml",
    "formName": "ФормаЭлемента"
  },
  "validatePath": "Catalogs/Товары/Forms/ФормаЭлемента",
  "expect": {
    "preserves": [
      {
        "file": "Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form.xml",
        "bom": true,
        "eol": "crlf",
        "encoding": "UTF-8",
        "finalNewline": false,
        "noCR13": true,
        "selfClose": "tight",
        "noEmptyPairs": true
      },
      {
        "file": "Catalogs/Товары/Forms/ФормаЭлемента/Ext/Form/Module.bsl",
        "bom": true,
        "eol": "crlf"
      }
    ]
  }
}
