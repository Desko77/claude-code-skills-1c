{
  "name": "добавление импорта",
  "caseFiles": [
    "common.xsd",
    "types.xsd"
  ],
  "preRun": [
    {
      "script": "xdto-compile/scripts/xdto-compile",
      "args": {
        "-XsdPath": "{workDir}/common.xsd",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "xdto-compile/scripts/xdto-compile",
      "args": {
        "-XsdPath": "{workDir}/types.xsd",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "packagePath": "XDTOPackages/types"
  },
  "args_extra": [
    "-Operation",
    "add-import",
    "-Value",
    "urn:test:common",
    "-NoValidate"
  ],
  "expect": {
    "files": [
      "XDTOPackages/types/Ext/Package.bin"
    ]
  }
}
