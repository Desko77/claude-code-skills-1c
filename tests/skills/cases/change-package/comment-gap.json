{
  "name": "Пакет правок: комментарий над методом остается в блоке замены",
  "setup": "fixture:comment-gap",
  "params": {
    "beforePath": "before",
    "afterPath": "after",
    "outFile": "package.md"
  },
  "idempotent": true,
  "expect": {
    "files": [
      "package.md"
    ],
    "stdoutContains": [
      "Модулей с правками: 1, методов изменено: 1, добавлено: 0, удалено: 0, правок вне методов: 0"
    ],
    "fileContains": [
      {
        "file": "package.md",
        "text": [
          "### Изменить метод СброситьКэш",
          "// Сбрасывает накопленный кэш значений.",
          "СчетчикСбросов = СчетчикСбросов + 1;"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "package.md",
        "text": [
          "### Изменить код вне методов",
          "### Заменить модуль целиком"
        ]
      }
    ],
    "preserves": {
      "file": "package.md",
      "bom": false,
      "eol": "lf",
      "finalNewline": true
    }
  }
}
