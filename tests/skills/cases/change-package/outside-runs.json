{
  "name": "Пакет правок: несмежные участки вне методов разделены по привязке",
  "setup": "fixture:outside-runs",
  "params": {
    "beforePath": "before",
    "afterPath": "after",
    "outFile": "package.md"
  },
  "idempotent": true,
  "expect": {
    "files": [
      "package.md"
    ],
    "stdoutContains": [
      "Модулей с правками: 1, методов изменено: 0, добавлено: 0, удалено: 0, правок вне методов: 2"
    ],
    "fileContains": [
      {
        "file": "package.md",
        "text": [
          "## CommonModules/Обмен/Ext/Module.bsl - Общий модуль Обмен",
          "### Изменить код вне методов после метода СброситьКэш",
          "### Изменить код вне методов в конце модуля",
          "МаксимумЗаписей = 200;",
          "ПорцияЗагрузки = 1000;"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "package.md",
        "text": [
          "### Изменить метод",
          "### Заменить модуль целиком"
        ]
      }
    ],
    "preserves": {
      "file": "package.md",
      "bom": false,
      "eol": "lf",
      "finalNewline": true
    }
  }
}
