{
  "name": "Пакет правок: изменение вне методов",
  "setup": "fixture:outside-methods",
  "params": {
    "beforePath": "before",
    "afterPath": "after",
    "outFile": "package.md"
  },
  "idempotent": true,
  "expect": {
    "files": ["package.md"],
    "stdoutContains": [
      "Модулей с правками: 1, методов изменено: 0, добавлено: 0, удалено: 0, правок вне методов: 1"
    ],
    "fileContains": [
      {
        "file": "package.md",
        "text": [
          "### Изменить код вне методов",
          "Перем КэшЗначений;",
          "Перем КэшЗначений, СчетчикВызовов;"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "package.md",
        "text": ["### Изменить метод СброситьКэш"]
      }
    ],
    "preserves": { "file": "package.md", "bom": false, "eol": "lf", "finalNewline": true }
  }
}
