{
  "name": "Пакет правок: асинхронный метод с измененным телом",
  "setup": "fixture:async-method",
  "params": {
    "beforePath": "before",
    "afterPath": "after",
    "outFile": "package.md"
  },
  "idempotent": true,
  "expect": {
    "files": [
      "package.md"
    ],
    "stdoutContains": [
      "Модулей с правками: 1, методов изменено: 1, добавлено: 0, удалено: 0, правок вне методов: 0"
    ],
    "fileContains": [
      {
        "file": "package.md",
        "text": [
          "### Изменить метод ЗагрузитьФайлы",
          "Найти:",
          "Заменить целиком на:",
          "Асинх Процедура ЗагрузитьФайлы()",
          "ПоместитьФайлы(Файлы);"
        ]
      }
    ],
    "fileNotContains": [
      {
        "file": "package.md",
        "text": [
          "### Заменить модуль целиком",
          "### Добавить метод",
          "### Удалить метод"
        ]
      }
    ],
    "preserves": {
      "file": "package.md",
      "bom": false,
      "eol": "lf",
      "finalNewline": true
    }
  }
}
