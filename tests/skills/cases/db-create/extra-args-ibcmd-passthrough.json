{
  "name": "Доп. аргументы ibcmd доходят до платформы, секрет замаскирован (fake platform)",
  "preRun": [
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\ibcmd.cmd",
    "-InfoBasePath",
    "{workDir}\\ib",
    "-AdditionalIbcmdArguments",
    "--verbose,--token=topsecret"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: infobase create",
      "--verbose --token=topsecret",
      "--token=***"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется командная строка в stdout, файлов на выходе нет",
  "osOnly": "win32"
}
