{
  "name": "Отказ: позиционный токен в -AdditionalIbcmdArguments ломает команду ibcmd",
  "preRun": [
    { "writeFile": { "path": "ibcmd.cmd", "content": "@echo off\r\nexit /b 0\r\n" } }
  ],
  "args_extra": ["-V8Path", "{workDir}\\ibcmd.cmd", "-InfoBasePath", "{workDir}\\ib",
                 "-AdditionalIbcmdArguments", "config"],
  "expectError": true,
  "noSnapshot": "негативный кейс: платформа не запускается"
}
