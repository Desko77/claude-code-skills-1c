{
  "name": "Доп. аргументы 1cv8 доходят до платформы (fake platform)",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-InfoBasePath",
    "{workDir}\\ib",
    "-AdditionalV8Arguments",
    "/UseHwLicenses+"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: CREATEINFOBASE",
      "/DisableStartupDialogs /UseHwLicenses+"
    ]
  },
  "expectError": true,
  "noSnapshot": "проверяется командная строка в stdout, файлов на выходе нет",
  "osOnly": "win32"
}
