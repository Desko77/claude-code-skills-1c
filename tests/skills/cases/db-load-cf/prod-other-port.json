{
  "name": "Другой порт отличает базу: запись srv01 prod не мешает запуску на srv01:1542",
  "osOnly": "win32",
  "cwd": "workDir",
  "preRun": [
    {
      "writeFile": {
        "path": ".v8-project.json",
        "content": {
          "databases": [
            {
              "id": "prod",
              "name": "Рабочая",
              "type": "server",
              "server": "srv01",
              "ref": "myapp_prod",
              "role": "prod"
            }
          ]
        }
      }
    },
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\nexit /b 1\r\n"
      }
    },
    {
      "writeFile": {
        "path": "cfg.cf",
        "content": "fake configuration\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-InfoBaseServer",
    "srv01:1542",
    "-InfoBaseRef",
    "myapp_prod",
    "-InputFile",
    "{workDir}\\cfg.cf"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": "Running: 1cv8.exe",
    "stderrNotContains": "помечена как боевая"
  },
  "noSnapshot": "негативный кейс: фейк платформы завершается кодом 1, навык ничего не пишет"
}
