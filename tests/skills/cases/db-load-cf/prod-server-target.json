{
  "name": "Сервер и путь вместе: цель серверная, файловая запись prod не срабатывает",
  "osOnly": "win32",
  "cwd": "workDir",
  "preRun": [
    {
      "writeFile": {
        "path": ".v8-project.json",
        "content": {
          "databases": [
            {
              "id": "prod",
              "name": "Рабочая",
              "type": "file",
              "path": "prod-base",
              "server": "srv01",
              "ref": "myapp_dev",
              "role": "prod"
            },
            {
              "id": "dev",
              "name": "Разработка",
              "type": "server",
              "server": "srv01",
              "ref": "myapp_dev",
              "role": "dev"
            }
          ]
        }
      }
    },
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\nexit /b 1\r\n"
      }
    },
    {
      "writeFile": {
        "path": "cfg.cf",
        "content": "fake configuration\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-InfoBaseServer",
    "srv01",
    "-InfoBaseRef",
    "myapp_dev",
    "-InfoBasePath",
    "{workDir}\\prod-base",
    "-InputFile",
    "{workDir}\\cfg.cf"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": "Running: 1cv8.exe",
    "stderrNotContains": "помечена как боевая"
  },
  "noSnapshot": "негативный кейс: фейк платформы завершается кодом 1, навык ничего не пишет"
}
