{
  "name": "Раундтрип макета ПЛАТФОРМЫ байт в байт: ЯчейкиСОформлением",
  "setup": "fixture:platform-roundtrip",
  "preRun": [
    {
      "script": "mxl-decompile/scripts/mxl-decompile",
      "args": {
        "-TemplatePath": "ЯчейкиСОформлением.xml",
        "-OutputPath": "back.json"
      },
      "cwd": "{workDir}"
    }
