  "params": {
    "outputPath": "out.xml"
  },
  "noSnapshot": "эталон — файл платформы, сверяется expect.filesEqual",
  "expect": {
    "filesEqual": {
      "actual": "out.xml",
      "expected": "ЯчейкиСОформлением.xml"
    }
  },
  "inputFrom": "back.json"
}