{
  "name": "Доп. аргументы доходят до временной базы (fake platform)",
  "osOnly": "win32",
  "preRun": [
    {
      "writeFile": {
        "path": "fake.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 1\r\n"
      }
    },
    {
      "writeFile": {
        "path": "src/Обработка.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MetaDataObject xmlns=\"http://v8.1c.ru/8.3/MDClasses\"/>\n"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\fake.cmd",
    "-SourceFile",
    "{workDir}\\src\\Обработка.xml",
    "-OutputFile",
    "{workDir}\\build\\Обработка.epf",
    "-AdditionalV8Arguments",
    "/UseHwLicenses+"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: CREATEINFOBASE",
      "/DisableStartupDialogs /UseHwLicenses+"
    ]
  },
  "expectError": true,
  "noSnapshot": "платформа фейковая и падает на первом запуске — проверяется её командная строка"
}
