{
  "script": "skd-validate/scripts/skd-validate",
  "setup": "none",
  "args": [
    {
      "flag": "-TemplatePath",
      "from": "workPath",
      "field": "templatePath"
    },
    {
      "flag": "-IndexPath",
      "from": "workPath",
      "field": "indexPath",
      "optional": true
    }
  ],
  "snapshot": {
    "root": "workDir",
    "normalizeUuids": true
  }
}
