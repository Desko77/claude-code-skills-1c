{
  "name": "Добавление макета к обработке",
  "preRun": [
    {
      "script": "epf-init/scripts/init",
      "args": {
        "-Name": "МояОбработка",
        "-SrcDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectName": "МояОбработка",
    "templateName": "Макет",
    "templateType": "SpreadsheetDocument"
  },
  "expect": {
    "preserves": {
      "file": "МояОбработка/Templates/Макет/Ext/Template.xml",
      "bom": true,
      "eol": "crlf",
      "encoding": "UTF-8",
      "finalNewline": false,
      "noCR13": true,
      "selfClose": "tight",
      "noEmptyPairs": true
    }
  }
}
