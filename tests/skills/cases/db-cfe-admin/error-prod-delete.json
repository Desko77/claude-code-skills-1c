{
  "name": "Отказ: delete на базе, помеченной боевой",
  "cwd": "workDir",
  "preRun": [
    {
      "writeFile": {
        "path": ".v8-project.json",
        "content": {
          "databases": [
            {
              "id": "dev",
              "name": "Разработка",
              "type": "server",
              "server": "srv01",
              "ref": "myapp_dev",
              "role": "dev"
            },
            {
              "id": "prod",
              "name": "Рабочая",
              "type": "server",
              "server": "srv01",
              "ref": "myapp_prod",
              "role": "prod"
            }
          ]
        }
      }
    }
  ],
  "args_extra": [
    "delete",
    "-V8Path",
    "{workDir}\\missing\\ibcmd.exe",
    "-InfoBaseServer",
    "SRV01",
    "-InfoBaseRef",
    "MyApp_Prod",
    "-Name",
    "DemoExt"
  ],
  "expectError": "помечена как боевая (role: prod)",
  "expect": {
    "stderrContains": [
      "База 'Рабочая'",
      "Изменяющая операция отменена. Запуск с"
    ],
    "stdoutNotContains": "ibcmd infobase"
  },
  "noSnapshot": "негативный кейс: отказ до запуска ibcmd"
}
