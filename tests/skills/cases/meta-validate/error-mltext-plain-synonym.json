{
  "name": "Synonym записан непустым текстом без v8:item - ошибка",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Catalog", "name": "Товары" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "editFile": "Catalogs/Товары.xml",
      "replace": "\t\t\t<Synonym>\r\n\t\t\t\t<v8:item>\r\n\t\t\t\t\t<v8:lang>ru</v8:lang>\r\n\t\t\t\t\t<v8:content>Товары</v8:content>\r\n\t\t\t\t</v8:item>\r\n\t\t\t</Synonym>",
      "with": "\t\t\t<Synonym>Синоним текстом</Synonym>"
    }
  ],
  "params": { "objectPath": "Catalogs/Товары.xml" },
  "expectError": true,
  "expect": {
    "stdoutContains": ["Synonym", "plain"]
  }
}
