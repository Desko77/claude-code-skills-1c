// Служебные функции конфигурации.

#Область ПрограммныйИнтерфейс

// Возвращает остаток номенклатуры на складе.
//
// Параметры:
//  Номенклатура - CatalogRef.Номенклатура - что считаем.
//  Склад - CatalogRef.Склады - где считаем.
//
// Возвращаемое значение:
//  Число - остаток.
//
Функция Остаток(Номенклатура, Склад = Неопределено) Экспорт
	Возврат 0;
КонецФункции

// Записывает остаток.
//
// Параметры:
//  Данные - Структура - что записываем.
//
Процедура ЗаписатьОстаток(Знач Данные = Неопределено) Экспорт
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Внутренняя проверка, наружу не отдается.
//
// Параметры:
//  Значение - Произвольный - что проверяем.
//
// Возвращаемое значение:
//  Булево - истина, если значение заполнено.
//
Функция ЗначениеЗаполнено(Значение)
	Возврат Значение <> Неопределено;
КонецФункции

#КонецОбласти