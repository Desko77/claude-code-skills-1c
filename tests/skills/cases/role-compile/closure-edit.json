{
  "name": "Замыкание Edit влечет Read, Update, View у справочника",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Товары"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "input": {
    "name": "РедакторТоваров",
    "objects": [
      "Catalog.Товары: Edit"
    ]
  },
  "validatePath": "Roles/РедакторТоваров",
