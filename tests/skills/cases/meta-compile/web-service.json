{
  "name": "Веб-сервис с операциями",
  "input": {
    "type": "WebService",
    "name": "СервисОбмена",
    "namespace": "http://example.com/exchange",
    "reuseSessions": "AutoUse",
    "descriptorFileName": "exchange.1cws",
    "xdtoPackages": ["http://v8.1c.ru/8.3/data/ext", "http://example.com/exchange"],
    "operations": {
      "ПолучитьДанные": {
        "returnType": "xs:string",
        "nillable": true,
        "transactioned": false,
        "parameters": {
          "ИдентификаторЗапроса": "xs:string",
          "ДатаНачала": "xs:dateTime"
        }
      },
      "ОбменСообщениями": {
        "returnType": "{http://example.com/exchange}MessageExchange",
        "procedureName": "ВыполнитьОбмен",
        "comment": "Основная операция",
        "parameters": {
          "Сообщение": { "type": "{http://example.com/exchange}MessageExchange", "nillable": false },
          "Ошибка": { "type": "xs:string", "nillable": false, "direction": "Out" }
        }
      }
    }
  },
  "validatePath": "WebServices/СервисОбмена",
  "expect": {
    "files": ["WebServices/СервисОбмена.xml", "WebServices/СервисОбмена/Ext/Module.bsl"]
  }
}
