Процедура ПрочитатьСвойство(Объект)
    Свойства = УправлениеСвойствами.ЗначенияСвойств(Объект);
    СкладХранения = Свойства.СкладХранения;
    Если СкладХранения = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ЗаписатьСклад(Объект, СкладХранения);
    Ответственный = Свойства.Ответственный;
    Если Ответственный <> Неопределено Тогда
        ЗаписатьОтветственного(Объект, Ответственный);
    КонецЕсли;
КонецПроцедуры
