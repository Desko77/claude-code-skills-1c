Процедура УстановитьСвойство(Объект, ИмяСвойства, Значение)
    Вид = ВидыХарактеристик.ДополнительныеРеквизиты.СоздатьЭлемент();
    Вид.Наименование = ИмяСвойства;
    Вид.Записать();
    Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
    Набор.Отбор.Объект.Установить(Объект);
    Строка = Набор.Добавить();
    Строка.Свойство = Вид.Ссылка;
    Строка.Значение = Значение;
    Набор.Записать(Истина);
КонецПроцедуры
