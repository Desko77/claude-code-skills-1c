&НаКлиенте
Процедура ЗаполнитьКонтрагента()
    Контрагент = ПолучитьКонтрагентаПоИНН();
    Если Контрагент = Неопределено Тогда
        ПоказатьПредупреждение(, "Не найден");
        Возврат;
    КонецЕсли;
    Контрагент.Наименование =
        СокрЛП(Контрагент.Наименование);
    Объект.Контрагент = Контрагент;
КонецПроцедуры
