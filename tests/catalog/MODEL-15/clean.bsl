Процедура ОчиститьДокумент(Заказ)
    Если Не ЗначениеЗаполнено(Заказ.Контрагент) Тогда
        Заказ.Контрагент =
            Справочники.Контрагенты.ПустаяСсылка();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Заказ.Договор) Тогда
        Заказ.Договор =
            Справочники.Договоры.ПустаяСсылка();
    КонецЕсли;
    Заказ.Основание = Документы.Заказ.ПустаяСсылка();
    Заказ.Записать();
КонецПроцедуры
