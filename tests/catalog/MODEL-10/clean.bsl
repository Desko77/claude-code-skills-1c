Остатки = Новый Соответствие;
Для Каждого Строка Из ТаблицаОстатков Цикл
    Ключ = Новый Структура("Номенклатура, Склад",
        Строка.Номенклатура, Строка.Склад);
    Остатки.Вставить(Ключ, Строка.Количество);
КонецЦикла;
КлючПоиска = Новый Структура("Номенклатура, Склад",
    Товар, Склад);
Найдено = Остатки.Получить(КлючПоиска);
Если Найдено = Неопределено Тогда
    Найдено = 0;
КонецЕсли;
