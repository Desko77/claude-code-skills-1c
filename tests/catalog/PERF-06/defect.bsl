Процедура ПровестиСписание(Документ)
    Статья = Справочники.СтатьиЗатрат.НайтиПоНаименованию(
        "Транспортные расходы");
    Склад = Справочники.Склады.НайтиПоКоду("000000004");
    Если Статья.Пустая() Или Склад.Пустая() Тогда
        ВызватьИсключение "Не найдены справочники";
    КонецЕсли;
    Документ.СтатьяЗатрат = Статья;
    Документ.Склад = Склад;
    Документ.Записать();
КонецПроцедуры
