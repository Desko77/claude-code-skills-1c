Процедура ПровестиСписание(Документ)
    Статья = Справочники.СтатьиЗатрат.ТранспортныеРасходы;
    Склад = Справочники.Склады.ОсновнойСклад;
    Если Статья.Пустая() Или Склад.Пустая() Тогда
        ВызватьИсключение "Не найдены предопределенные элементы";
    КонецЕсли;
    Документ.СтатьяЗатрат = Статья;
    Документ.Склад = Склад;
    Документ.Записать();
КонецПроцедуры
