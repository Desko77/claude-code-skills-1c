Процедура ЗаполнитьДанныеКонтрагента(Контрагент)
    Реквизит = Метаданные.Справочники.Контрагенты
        .Реквизиты.Найти("СрокОплаты");
    Если Реквизит <> Неопределено Тогда
        Контрагент.СрокОплаты = 5;
    КонецЕсли;
    РеквизитВид = Метаданные.Справочники.Контрагенты
        .Реквизиты.Найти("ВидДеятельности");
    Если РеквизитВид <> Неопределено Тогда
        Контрагент.ВидДеятельности =
            Перечисления.ВидыДеятельности.Оптовая;
    КонецЕсли;
КонецПроцедуры
