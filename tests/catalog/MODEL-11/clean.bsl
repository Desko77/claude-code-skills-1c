Процедура ЗаполнитьДанныеКонтрагента(Контрагент)
    Если Не Контрагент.ПометкаУдаления Тогда
        Контрагент.СрокОплаты = 5;
        Контрагент.ВидДеятельности =
            Перечисления.ВидыДеятельности.Оптовая;
        Контрагент.Наименование =
            СокрЛП(Контрагент.Наименование);
        Контрагент.Комментарий = "Заполнено автоматически";
    КонецЕсли;
КонецПроцедуры
