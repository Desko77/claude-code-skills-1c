Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ
|    Заказы.Ссылка КАК Ссылка,
|    ЕСТЬNULL(ИтогиОплат.СуммаОплат, 0) КАК СуммаОплат
|ИЗ
|    Документ.Заказ КАК Заказы
|        ЛЕВОЕ СОЕДИНЕНИЕ ВТИтогиОплат КАК ИтогиОплат
|        ПО Заказы.Ссылка = ИтогиОплат.Заказ";
Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
    ОсталосьСписать = Заказ.Сумма - Выборка.СуммаОплат;
    ЗаписатьОстаток(Выборка.Ссылка, ОсталосьСписать);
КонецЦикла;
