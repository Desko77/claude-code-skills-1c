Процедура ЗаполнитьЦены(Товары)
    Валюта = Константы.ВалютаУчета.Получить();
    Организация = Справочники.Организации.Основная;
    Склад = Константы.СкладПоУмолчанию.Получить();
    Ставка = Константы.СтавкаНДС.Получить();
    Для Каждого Товар Из Товары Цикл
        Товар.Валюта = Валюта;
        Товар.Организация = Организация;
        Товар.Склад = Склад;
        Товар.СтавкаНДС = Ставка;
    КонецЦикла;
КонецПроцедуры
