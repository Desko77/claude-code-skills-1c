Процедура НапечататьШапку(Документ)
    Текст = Новый Массив;
    Текст.Добавить(Документ.Дата);
    Текст.Добавить(НомерДокументаСтрокой(Документ));
    ВывестиТекст(Текст);
КонецПроцедуры

Процедура НапечататьПодвал(Документ)
    Текст = Новый Массив;
    Текст.Добавить(Документ.Организация);
    ВывестиТекст(Текст);
КонецПроцедуры
