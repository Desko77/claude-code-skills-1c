Процедура ОбработатьОтвет(Ответ)
    Данные = ПолучитьДанныеОтвета(Ответ);
    Если Данные.Код = 0 Тогда
        ОтправитьУведомление(Данные.Номер);
        ЗаписатьЖурнал(Данные.ДатаОтвета);
        СохранитьНомер(Данные.Номер);
        СчетчикУспеха = СчетчикУспеха + 1;
    Иначе
        СчетчикОшибок = СчетчикОшибок + 1;
    КонецЕсли;
КонецПроцедуры
