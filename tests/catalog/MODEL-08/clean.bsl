Процедура ЗаписатьФайл(Данные, Путь)
    Параметры = Новый ПараметрыЗаписиJSON(
        ПереносСтрокJSON.Авто, СимволыОтступа.Табуляция);
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь);
    Запись.УстановитьСтроку(, Параметры);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры

Процедура СохранитьНастройки(Настройки)
    ЗаписатьФайл(Настройки, ПолучитьПутьНастроек());
КонецПроцедуры
