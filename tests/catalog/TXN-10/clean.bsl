Процедура ПровестиЗагрузку(Документ)
    ОтветСервиса = ОтправитьЗапросНаружу(ПараметрыЗапроса);
    НачатьТранзакцию();
    Попытка
        Документ.Записать(РежимЗаписиДокумента.Проведение);
        ЗаписатьРезультат(Документ, ОтветСервиса);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
