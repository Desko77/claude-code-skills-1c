// Индекс документа Реализация: (Организация, Контрагент, Дата)
Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ
|    Реализации.Ссылка КАК Ссылка
|ИЗ
|    Документ.Реализация КАК Реализации
|ГДЕ
|    Реализации.Контрагент = &Контрагент
|    И Реализации.Дата >= &ДатаНачала";
Запрос.УстановитьПараметр("Контрагент", Контрагент);
Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
