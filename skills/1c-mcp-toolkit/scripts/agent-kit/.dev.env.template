# Шаблон .dev.env для 1c-agent-kit. Скопируй в свой проект как .dev.env и заполни.
# Формат: KEY=VALUE, без кавычек. Пути Windows — как есть (обратные слэши).

# --- База ---
INFOBASE_KIND=File
# Для файловой (INFOBASE_KIND=File):
INFOBASE_PATH=D:\bases\MyBase
# Для серверной (INFOBASE_KIND=Server) — вместо INFOBASE_PATH заполни:
# INFOBASE_SERVER=srv01\MyBase

# --- Платформа --- (каталог bin ИЛИ полный путь к 1cv8.exe/1cv8c.exe)
PLATFORM_PATH=C:\Program Files\1cv8\8.3.27.1936\bin

# --- Учётные данные ИБ ---
IB_USER=Admin
IB_PASSWORD=

# --- MCP Toolkit (канал данных) ---
# Скачать MCP_Toolkit.epf: https://github.com/ROCTUP/1c-mcp-toolkit (папка build/, x64/x86)
TOOLKIT_EPF=C:\Users\<user>\.claude\skills\1c-mcp-toolkit\bin\MCP_Toolkit.epf
TOOLKIT_PORT=6003

# --- Рабочие каталоги ---
WORK_DIR=D:\proj\1c-work
BACKUP_DIR=D:\proj\1c-work\backup
SRC_DIR=D:\proj\1c-work\src
# (канал кода выгружает в SRC_DIR\cf, бэкап в BACKUP_DIR\config_baseline.cf)
